# Copy to .env.local and fill in. Never commit .env.local.

# --- Site ---
# Public base URL, e.g. http://localhost:3000 locally or the Netlify URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Comma-separated emails that get the admin role on sign-in.
ADMIN_EMAILS=
# Random string; scheduled functions send it as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=

# --- Supabase (Project Settings → API; `npx supabase status` for local) ---
# Project URL.
NEXT_PUBLIC_SUPABASE_URL=
# Anon (public) key, safe in the browser; access is limited by RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key. Server only, bypasses RLS. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# --- Google (Maps JavaScript + Places, restricted to your domains) ---
# Browser key for maps and address autocomplete.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# --- LINE (one provider: a Login channel + a Messaging API channel) ---
# LINE Login channel ID.
LINE_LOGIN_CHANNEL_ID=
# LINE Login channel secret.
LINE_LOGIN_CHANNEL_SECRET=
# Messaging API channel secret, used to verify webhook signatures.
LINE_MESSAGING_CHANNEL_SECRET=
# Messaging API long-lived channel access token, used to push messages.
LINE_MESSAGING_ACCESS_TOKEN=

# --- Stripe (TEST MODE ONLY until the owner says otherwise) ---
# Secret key, must start with sk_test_.
STRIPE_SECRET_KEY=
# Publishable key, must start with pk_test_.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Signing secret for /api/webhooks/stripe (whsec_...).
STRIPE_WEBHOOK_SECRET=

# --- Resend (customer email) ---
# API key.
RESEND_API_KEY=
# Sender, e.g. "Bookings <bookings@yourdomain.com>" on a verified domain.
EMAIL_FROM=

# --- WhatsApp Business (Phase 7, leave blank until then) ---
# Meta Cloud API access token.
WHATSAPP_TOKEN=
# Sending phone number ID.
WHATSAPP_PHONE_NUMBER_ID=
