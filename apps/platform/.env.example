# Copy to .env.local and fill in. Never commit .env.local.
# On Netlify every context points at the staging project until Gate A.

# --- Supabase (Project Settings → API; `npx supabase status` for local) ---
# Project URL.
NEXT_PUBLIC_SUPABASE_URL=
# Anon (public) key, safe in the browser; access is limited by RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key. Local DB tests and the seed script only; the app never
# uses it. Never expose it to the browser or set it on Netlify.
SUPABASE_SERVICE_ROLE_KEY=

# --- Sign-in ---
# Social sign-in buttons to show: any of line,google. Only list providers
# enabled in the Supabase project. Email (password or link) is always shown.
NEXT_PUBLIC_AUTH_PROVIDERS=

# --- Sentry (optional; Sentry stays off when the DSN is blank) ---
# Project DSN from Sentry → Project settings → Client keys.
NEXT_PUBLIC_SENTRY_DSN=
# Environment name shown in Sentry, e.g. staging or production.
NEXT_PUBLIC_SENTRY_ENVIRONMENT=

# --- Demo data (scripts/seed.ts) ---
# Password the seed gives every demo user, local and staging. Pick your own;
# the repo is public, so it never goes in a committed file.
DEMO_PASSWORD=

# --- Staging (mango-works-staging), used from your machine only ---
# Session pooler connection string with the database password
# (Dashboard → Connect → Session pooler). For `supabase db push`.
STAGING_DB_URL=
# Project URL, https://<project-ref>.supabase.co. For `npm run seed:staging`.
STAGING_SUPABASE_URL=
# Secret (service role) key of the staging project. For `npm run seed:staging`.
STAGING_SUPABASE_SECRET_KEY=
